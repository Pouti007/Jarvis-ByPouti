# Copy this file to .env and fill in your own keys. .env is git-ignored.
# You need at least ONE of the two AI keys below.

# Claude (paid, best quality) — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# NVIDIA (free, rate-limited) — sign in at https://build.nvidia.com and create an API key (starts with nvapi-)
NVIDIA_API_KEY=

# Optional — enables live stock quotes; free at https://finnhub.io/register
FINNHUB_API_KEY=
